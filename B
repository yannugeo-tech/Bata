-- 1초마다 바닥 아래로 숨었다가 위로 올라오는 루프 (Ragebot ting)
task.spawn(function()
	local hiddenState = false
	local savedPos = nil
	while true do
		task.wait(1)
		if Library.Unloaded then 
			break 
		end
		
		local player = game.Players.LocalPlayer
		local character = player and player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		
		if Toggles.RagebotEnabled and Toggles.RagebotEnabled.Value and rootPart then
			if not savedPos then
				savedPos = rootPart.CFrame
			end
			
			hiddenState = not hiddenState
			if hiddenState then
				rootPart.CFrame = savedPos - Vector3.new(0, 10, 0)
			else
				rootPart.CFrame = savedPos
			end
		else
			savedPos = nil
		end
	end
end)

-- 보이드 스팸(Void Spam) 백그라운드 로직 연결
game:GetService("RunService").Heartbeat:Connect(function(dt)
	if Library.Unloaded then return end
	if not Toggles.VoidSpamEnabled or not Toggles.VoidSpamEnabled.Value then return end
	
	local player = game.Players.LocalPlayer
	local character = player and player.Character
	if not character then return end
	
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then return end
	
	if humanoid:GetState() == Enum.HumanoidStateType.Dead then return end
	
	local randomOffset = (math.random() - 0.5) * 15
	local currentVelocity = rootPart.AssemblyLinearVelocity
	
	rootPart.AssemblyLinearVelocity = Vector3.new(
		currentVelocity.X + (math.random(-10, 10)),
		randomOffset * 3,
		currentVelocity.Z + (math.random(-10, 10))
	)
end)

